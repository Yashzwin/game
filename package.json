{
  "name": "ai-game-studio",
  "version": "1.0.0",
  "description": "Professional AI Game Studio powered by OpenRouter",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "start": "node server/index.js",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "setup": "npm run install:all && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ws": "^8.14.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "fs-extra": "^11.1.1",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}