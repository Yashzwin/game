# ─────────────────────────────────────────────────────────────
#  OPTIONAL — the studio is configured in the WEB UI.
#  Open the app, click Settings, and paste your API key there.
#  These variables only act as fallbacks if the UI has no value.
# ─────────────────────────────────────────────────────────────

# Fallback API key (get one free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Fallback base URL — any OpenAI-compatible endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server port (default 3001)
PORT=3001

# Force demo mode: 1 = generate canned demo games, no API key needed
MOCK_AI=0
