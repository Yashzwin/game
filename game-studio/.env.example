# --- Required for real AI generation ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Server ---
PORT=3001
GAMES_DIR=./server/games

# --- Demo mode ---
# Set to 1 to try the full studio pipeline WITHOUT an API key.
# Generates canned 2D/3D demo games so you can explore the UI.
MOCK_AI=0
